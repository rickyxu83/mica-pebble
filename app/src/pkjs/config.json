[
  {
    "type": "heading",
    "defaultValue": "Wrist",
    "size": 1
  },
  {
    "type": "section",
    "items": [
      {
        "type": "select",
        "id": "LLM_PROVIDER",
        "messageKey": "LLM_PROVIDER",
        "label": "AI provider",
        "description": "Choose your LLM backend. Keys are stored locally on the phone; requests go directly from the phone to the provider. No server, no subscription.",
        "defaultValue": "gemini",
        "options": [
          {
            "label": "Google Gemini",
            "value": "gemini"
          },
          {
            "label": "OpenAI-compatible (OpenAI / DeepSeek / Kimi / Qwen / Ollama / LM Studio)",
            "value": "openai"
          },
          {
            "label": "Anthropic Claude",
            "value": "claude"
          }
        ]
      },
      {
        "type": "heading",
        "defaultValue": "Assistant"
      },
      {
        "type": "select",
        "id": "ASSISTANT_RUNTIME",
        "messageKey": "ASSISTANT_RUNTIME",
        "label": "Runtime",
        "description": "Automatic sends prompts to the Android companion when it is installed. Choose Companionless when using only the PBW.",
        "defaultValue": "automatic",
        "options": [
          {
            "label": "Automatic",
            "value": "automatic"
          },
          {
            "label": "Companionless",
            "value": "companionless"
          },
          {
            "label": "Android companion",
            "value": "android"
          }
        ]
      },
      {
        "type": "input",
        "id": "GEMINI_API_KEY",
        "messageKey": "GEMINI_API_KEY",
        "label": "Gemini API key",
        "description": "Stored locally by the Pebble phone app. Required for companionless mode.",
        "defaultValue": ""
      },
      {
        "type": "input",
        "id": "GEMINI_MODEL",
        "messageKey": "GEMINI_MODEL",
        "label": "Gemini model",
        "description": "The Gemini API model used by the local assistant runtime.",
        "defaultValue": "gemini-3.1-flash-lite"
      },
      {
        "type": "input",
        "id": "OPENAI_API_KEY",
        "messageKey": "OPENAI_API_KEY",
        "label": "OpenAI-compatible API key",
        "description": "Required when provider is OpenAI-compatible. For local Ollama/LM Studio any non-empty placeholder works.",
        "defaultValue": ""
      },
      {
        "type": "input",
        "id": "OPENAI_BASE_URL",
        "messageKey": "OPENAI_BASE_URL",
        "label": "OpenAI-compatible base URL",
        "description": "Leave blank for https://api.openai.com/v1. Examples: https://api.deepseek.com/v1 · https://api.moonshot.cn/v1 · https://dashscope.aliyuncs.com/compatible-mode/v1 · http://<电脑IP>:11434/v1 (Ollama, same Wi-Fi)",
        "defaultValue": ""
      },
      {
        "type": "input",
        "id": "OPENAI_MODEL",
        "messageKey": "OPENAI_MODEL",
        "label": "OpenAI-compatible model",
        "description": "Examples: gpt-4o-mini · deepseek-chat · moonshot-v1-8k · qwen-plus · llama3.1",
        "defaultValue": "gpt-4o-mini"
      },
      {
        "type": "input",
        "id": "CLAUDE_API_KEY",
        "messageKey": "CLAUDE_API_KEY",
        "label": "Anthropic Claude API key",
        "description": "Required when provider is Claude.",
        "defaultValue": ""
      },
      {
        "type": "input",
        "id": "CLAUDE_MODEL",
        "messageKey": "CLAUDE_MODEL",
        "label": "Claude model",
        "description": "Examples: claude-sonnet-4-5 · claude-haiku-4-5",
        "defaultValue": "claude-sonnet-4-5"
      },
      {
        "type": "input",
        "id": "GEMINI_MONTHLY_BUDGET_USD",
        "messageKey": "GEMINI_MONTHLY_BUDGET_USD",
        "label": "Gemini monthly budget",
        "description": "Used only for Billy's local estimate on the Quota screen. Google AI Studio billing is authoritative.",
        "defaultValue": "10"
      },
      {
        "type": "input",
        "id": "GITHUB_ISSUES_URL",
        "messageKey": "GITHUB_ISSUES_URL",
        "label": "Feedback GitHub issues URL",
        "description": "Optional. Leave blank if you have no issue tracker.",
        "defaultValue": ""
      },
      {
        "type": "input",
        "id": "FEEDBACK_POST_URL",
        "messageKey": "FEEDBACK_POST_URL",
        "label": "Feedback POST endpoint",
        "description": "Optional. Bobby-style feedback posts JSON here and returns Sent/Error on the watch. Leave blank to open a prefilled GitHub issue instead.",
        "defaultValue": ""
      },
      {
        "type": "input",
        "id": "USER_PROFILE_CONTEXT",
        "messageKey": "USER_PROFILE_CONTEXT",
        "label": "Assistant profile context",
        "description": "Optional companionless memory/profile notes Wrist should use, such as preferred name, home timezone, family names, pets, or preferences. Stored locally by the Pebble phone app.",
        "defaultValue": ""
      }
    ]
